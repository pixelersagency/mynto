{
  "name": "@mynto/mcp",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "MCP server of a mynto install: tool definitions shared with the web app (/mcp) and a stdio bin that talks to the REST API",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "mynto-mcp": "./dist/mynto-mcp.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mynto/shared": "workspace:^",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mynto/eslint-config": "workspace:*",
    "@mynto/tsconfig": "workspace:*",
    "@types/node": "^22.9.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
