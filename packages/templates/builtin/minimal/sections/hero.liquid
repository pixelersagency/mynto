<section class="mr-hero" aria-labelledby="mr-title">
  <p class="mr-kicker mr-hero__site">{{ audit.host }}</p>
  <h1 id="mr-title" class="mr-title">{% include 'sections/headline' %}</h1>
  {% if texts.intro %}<p class="mr-intro">{{ texts.intro }}</p>{% endif %}
  <div class="mr-hero__grid">
    <div class="mr-score">
      {% if score.value != nil %}<p class="mr-score__num"><span class="mr-visually-hidden">Score global : </span>{{ score.value }}<span class="mr-score__of"><span aria-hidden="true">/100</span><span class="mr-visually-hidden"> sur 100</span></span></p>{% else %}<p class="mr-score__num mr-score__num--off"><span aria-hidden="true">–</span><span class="mr-visually-hidden">Score global non évalué</span></p>{% endif %}
      <p class="mr-score__meta">{% if score.value != nil %}<span class="mr-band mr-band--{{ score.band }}">{{ score.band_label }}</span> · {% include 'sections/oneliner' %}{% else %}Score global non évalué.{% endif %}</p>
      {% if score.partial and score.value != nil %}<p class="mr-note">Calculé sur {{ score.evaluated_axes }} axes sur {{ score.total_axes }}.</p>{% endif %}
    </div>
    {% include 'sections/radar' %}
  </div>
  {% if summary.impact %}<h2 class="mr-visually-hidden">En bref</h2><p class="mr-hero__impact">{{ summary.impact }}</p>{% endif %}
  {% if cost or mode == 'web' %}
  <div class="mr-paper mr-hero__bar">
    {% if cost %}<p class="mr-hero__cost">Corriger l’essentiel : <strong>{{ cost.days_label }}</strong>, soit <strong>{{ cost.amount_label }}</strong></p>{% endif %}
    {% include 'sections/actions' %}
  </div>
  {% endif %}
  {% include 'sections/facts' %}
</section>
