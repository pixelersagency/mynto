<header class="mr-header mr-card">
  <p class="mr-brand">{% if agency.logo_url %}<img class="mr-brand__logo" src="{{ agency.logo_url }}" alt="" width="28" height="28">{% else %}<span class="mr-brand__mark" aria-hidden="true">{{ agency.initial }}</span>{% endif %}{% if agency.website_url %}<a class="mr-brand__name" href="{{ agency.website_url }}">{{ agency.name }}</a>{% else %}<span class="mr-brand__name">{{ agency.name }}</span>{% endif %}</p>
  {% if tracking.enabled and mode == 'web' %}<p class="mr-tracking">{{ tracking.notice }} <a href="#confidentialite">En savoir plus</a></p>{% endif %}
  <p class="mr-header__meta">Audit web · <time datetime="{{ audit.created_at }}">{{ audit.created_label }}</time></p>
</header>
