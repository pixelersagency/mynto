<section class="mr-section mr-axes" aria-labelledby="mr-axes-title">
  <h2 id="mr-axes-title" class="mr-h2"><span class="mr-tag">Scores par axe</span> <span class="mr-h2__title">Huit axes, <span class="mr-h2__soft">un score chacun</span></span></h2>
  <ul class="mr-tiles">
    {% for a in axes %}
    <li class="mr-tile{% unless a.evaluated %} is-off{% endunless %}">
      <span class="mr-tile__name">{{ a.label }}</span>
      <span class="mr-tile__value mr-tile__value--{% if a.evaluated %}{{ a.score.band }}{% else %}none{% endif %}">{% if a.evaluated %}{{ a.score.value }}<span class="mr-visually-hidden"> sur 100</span>{% else %}<span aria-hidden="true">–</span>{% endif %}</span>
      <span class="mr-tile__meta">{% if a.evaluated %}{{ a.score.band_label }}, {% if a.findings_count == 0 %}aucun problème{% else %}{{ a.findings_count }} {{ a.findings_count | plural: 'problème', 'problèmes' }}{% endif %}{% else %}Non évalué pour cet audit{% endif %}</span>
    </li>
    {% endfor %}
    {% unless show_ai %}
    <li class="mr-tile mr-tile--ai{% unless ai.evaluated and ai.score.value != nil %} is-off{% endunless %}">
      <span class="mr-tile__name">Préparation IA</span>
      <span class="mr-tile__value mr-tile__value--{% if ai.evaluated and ai.score.value != nil %}{{ ai.score.band }}{% else %}none{% endif %}">{% if ai.evaluated and ai.score.value != nil %}{{ ai.score.value }}<span class="mr-visually-hidden"> sur 100</span>{% else %}<span aria-hidden="true">–</span>{% endif %}</span>
      <span class="mr-tile__meta">{% if ai.evaluated and ai.score.value != nil %}{{ ai.score.band_label }}, niveau {{ ai.level }} sur {{ ai.max_level }}{% elsif ai.failed %}Site injoignable pendant le test{% else %}Non évalué pour cet audit{% endif %}{% if ai.evaluated and ai.score.value != nil %}, {% if ai.included_in_global_score %}dans le score global{% else %}hors score global{% endif %}{% endif %}</span>
    </li>
    {% endunless %}
  </ul>
</section>
