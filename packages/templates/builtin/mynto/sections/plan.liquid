{% if priorities.size > 0 %}
<section class="mr-section mr-plan-section" aria-labelledby="mr-plan-title">
  <h2 id="mr-plan-title" class="mr-h2"><span class="mr-tag">Plan d’action</span> <span class="mr-h2__title">{% case priorities.size %}{% when 1 %}Une étape, <span class="mr-h2__soft">à faire en premier</span>{% when 2 %}Deux étapes, <span class="mr-h2__soft">dans cet ordre</span>{% else %}Trois étapes, <span class="mr-h2__soft">dans cet ordre</span>{% endcase %}</span></h2>
  <ol class="mr-plan">
    {% for p in priorities %}
    <li class="mr-plan__step">
      <span class="mr-plan__n" aria-hidden="true">{% if p.rank < 10 %}0{% endif %}{{ p.rank }}</span>
      <div class="mr-plan__body">
        <h3 class="mr-plan__title"><span class="mr-visually-hidden">Étape {{ p.rank }} : </span>{{ p.title }}</h3>
        <p class="mr-plan__reason">{{ p.reason }}</p>
        {% if p.expected_outcome %}<p class="mr-plan__gain"><span class="mr-plan__label">Gain attendu</span> {{ p.expected_outcome }}</p>{% endif %}
        {% if show_issues and p.findings.size > 0 %}<ul class="mr-plan__links" aria-label="Problèmes liés">{% for f in p.findings %}<li><a href="#{{ f.anchor }}">{{ f.title }}</a></li>{% endfor %}</ul>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ol>
</section>
{% endif %}
