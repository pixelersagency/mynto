# =====================================================================
# mynto : configuration de l'installation
# =====================================================================
#
# Copie ce fichier en .env (Docker) ou .env.local (développement), ou
# laisse `pnpm run setup` le faire : il génère les secrets et demande
# l'email et le mot de passe admin.
#
# Règles :
#   - jamais de vraie valeur dans ce fichier (il est versionné) ;
#   - une valeur vide (VAR=) compte comme « non définie » ;
#   - [obligatoire] : le service refuse de démarrer sans ;
#   - [optionnelle] : valeur par défaut indiquée, ou fonction désactivée ;
#   - les secrets se génèrent avec openssl (commandes indiquées) ;
#   - web et scanner lisent le même fichier : une seule valeur par clé.
#
# Avec docker compose, DATABASE_URL, REDIS_URL, MEDIA_DIR, SCANNER_API_URL
# et WEB_BASE_URL sont câblées par docker-compose.yml : inutile de les
# remplir ici.
# =====================================================================


# ---------------------------------------------------------------------
# 1. Docker compose
# ---------------------------------------------------------------------

# [obligatoire en Docker] Mot de passe de l'utilisateur Postgres « mynto ».
# Lettres et chiffres seulement (il entre dans une URL).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# [optionnelle] Adresse et port publiés pour le web. 127.0.0.1 par défaut :
# un reverse proxy sur la même machine termine le HTTPS (voir README).
# MYNTO_BIND=127.0.0.1
# MYNTO_PORT=3000

# [optionnelle] Registre et version des images. Par défaut les images sont
# construites localement (docker compose build).
# MYNTO_IMAGE_REGISTRY=mynto
# MYNTO_VERSION=latest


# ---------------------------------------------------------------------
# 2. Adresse publique
# ---------------------------------------------------------------------

# [obligatoire en production] URL publique de l'installation, sans « / »
# final, telle que tes prospects la voient. Sert aux liens copiés et
# envoyés (/r/<jeton>), au cookie Secure, à HSTS et à
# upgrade-insecure-requests quand elle commence par https://, et au
# User-Agent du robot d'audit. Défaut : http://localhost:3000.
PUBLIC_URL=https://audit.example.com


# ---------------------------------------------------------------------
# 3. Compte administrateur (un seul par installation)
# ---------------------------------------------------------------------

# [obligatoire] Email de connexion au tableau de bord.
ADMIN_EMAIL=admin@example.com

# [obligatoire] Hash scrypt du mot de passe (12 caractères minimum).
#   pnpm admin:hash-password
# ou, sans Node sur la machine :
#   docker run --rm -it -v "$PWD/apps/web/scripts:/s:ro" node:22-alpine node /s/hash-password.mjs
# Le format (scrypt:N:r:p:sel:clé) ne contient pas de « $ » : pas
# d'échappement nécessaire.
ADMIN_PASSWORD_HASH=

# [optionnelle, déconseillée] Mot de passe en clair, pour un premier essai
# seulement (avertissement au démarrage). Ignoré si le hash est défini.
# ADMIN_PASSWORD=

# [obligatoire] Signe le cookie de session (7 jours). 32 caractères minimum.
# Le changer déconnecte tout le monde.
#   openssl rand -hex 32
SESSION_SECRET=


# ---------------------------------------------------------------------
# 4. Secrets partagés web + scanner
# ---------------------------------------------------------------------

# [obligatoire] Jeton que le web envoie au scanner (en-tête
# x-internal-token) pour créer, rafraîchir et supprimer des audits.
# 32 caractères minimum. Sans lui, ces routes du scanner répondent 503.
#   openssl rand -hex 32
SCANNER_INTERNAL_TOKEN=

# [fortement recommandée] 32 octets aléatoires (base64 ou hex) qui
# chiffrent en AES-256-GCM les clés IA, le mot de passe SMTP et les
# secrets de webhooks enregistrés depuis le tableau de bord. Sans elle,
# ces réglages ne peuvent pas être enregistrés.
# La perdre = devoir ressaisir ces secrets. La changer : pnpm keys:rotate
# (voir README, « Rotation de APP_ENCRYPTION_KEY »).
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# [recommandée] Secret HMAC des empreintes d'IP des ouvertures de rapports
# (dédoublonnage sur 30 minutes, aucune IP en clair). 16 caractères
# minimum. Non définie : un secret aléatoire par démarrage (le
# dédoublonnage marche, mais pas d'un redémarrage à l'autre).
#   openssl rand -hex 32
AUDIT_VIEWS_IP_HASH_SECRET=

# [obligatoire, scanner] Jeton admin du scanner : statistiques des files
# (/api/admin/queue-stats) et test de sortie Internet
# (/health?outbound=1). 16 caractères minimum. Jamais exposé au public.
#   openssl rand -hex 32
ADMIN_TOKEN=


# ---------------------------------------------------------------------
# 5. Marque de l'agence (valeurs du premier démarrage, ensuite modifiables
#    dans Réglages > Marque)
# ---------------------------------------------------------------------

# [optionnelle] Défaut : « Mon agence ».
AGENCY_NAME=Mon agence
# [optionnelles]
# AGENCY_WEBSITE_URL=https://agence.example
# AGENCY_CONTACT_URL=https://agence.example/contact
# AGENCY_PRIMARY_COLOR=#2563EB
# AGENCY_REPORT_FOOTER=


# ---------------------------------------------------------------------
# 6. IA (rédaction du rapport, lecture de la capture d'écran)
# ---------------------------------------------------------------------
# Normalement réglé dans le tableau de bord (Réglages > IA), clés
# chiffrées en base. Les valeurs ci-dessous ne servent que de repli quand
# rien n'y est enregistré. Sans aucune clé, le rapport garde sa synthèse
# déterministe (aucun appel à un LLM, aucun coût).

# [optionnelle] anthropic (défaut) | gemini | mistral
# AUDIT_LLM_PROVIDER=anthropic
# [optionnelle] Défaut selon le fournisseur (claude-haiku-5-5 pour Anthropic).
# AUDIT_LLM_MODEL=
# [optionnelle] anthropic (défaut) | gemini
# VISION_LLM_PROVIDER=anthropic
# VISION_LLM_MODEL=
# [optionnelles] Clés des fournisseurs (8 caractères minimum).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# [optionnelle] Plafond quotidien d'analyses de captures (toute
# l'installation). Défaut 500.
# VISION_DAILY_QUOTA=500
# [optionnelle] Durée de cache des réglages IA lus en base, en ms. Défaut 30000.
# AI_CONFIG_CACHE_MS=30000


# ---------------------------------------------------------------------
# 7. Audits (scanner)
# ---------------------------------------------------------------------

# [optionnelles] Collecteurs lourds : chacun lance un Chromium (400 à 600 Mo
# de RAM). Activés par défaut. Les réglages « Modules d'audit » peuvent
# seulement les éteindre, jamais forcer un collecteur coupé ici.
# AUDIT_RUN_LIGHTHOUSE=1
# AUDIT_RUN_AXE=1

# [optionnelles] Chiffrage indicatif du temps de correction. Le taux saisi
# dans Réglages > Marque l'emporte.
# AUDIT_DAILY_RATE_EUR=500
# AUDIT_BILLABLE_HOURS_PER_DAY=7

# [optionnelle] Audits lancés par heure et par IP appelante. Défaut 60.
# RATE_LIMIT_AUDITS_PER_IP_PER_HOUR=60

# [optionnelle] User-Agent complet du robot d'audit. Défaut :
# « Mozilla/5.0 (compatible; MyntoAudit/<version>; +<PUBLIC_URL>) ».
# AUDIT_USER_AGENT=

# [optionnelle] Résolution DNS de la garde anti-SSRF : system (défaut) ou
# doh (DNS-over-HTTPS chez Cloudflare 1.1.1.1, puis Google 8.8.8.8).
# Utile quand le DNS de la machine est filtré ou mandaté (VPN, DNS
# d'entreprise qui répond une fausse adresse) : sinon chaque audit est
# refusé comme « adresse privée ». Les adresses privées et réservées
# restent refusées dans les deux cas.
# SCANNER_DNS_RESOLVER=system

# [optionnelle] Délai maximum d'arrêt du scanner (ms). Passé ce délai, il
# sort de force (un audit en cours reprend au démarrage suivant). Défaut
# 8000, à garder sous stop_grace_period (15 s dans docker-compose.yml).
# SHUTDOWN_TIMEOUT_MS=8000
# [optionnelle] Idem pour le web. Défaut 8000.
# WEB_SHUTDOWN_TIMEOUT_MS=8000

# [optionnelle] Appliquer les migrations au démarrage du scanner (verrou
# Postgres, sans risque avec plusieurs scanners). Défaut 1. À 0, lance
# `pnpm db:migrate` toi-même.
# DB_MIGRATE_ON_START=1

# [optionnelle] Origines autorisées par le CORS du scanner (liste séparée
# par des virgules). Le web l'appelle côté serveur : inutile en Docker.
# ALLOWED_ORIGINS=http://localhost:3000


# ---------------------------------------------------------------------
# 8. API publique, MCP et webhooks sortants
# ---------------------------------------------------------------------

# [optionnelle] Requêtes par minute et par clé API sur /api/v1 et /mcp.
# Partagé entre processus web via Redis quand REDIS_URL est défini.
# Défaut 120.
# API_RATE_LIMIT_PER_MINUTE=120

# [optionnelle] 1 = les webhooks peuvent viser des adresses privées et du
# http:// (n8n auto-hébergé sur le même réseau). 0 par défaut : HTTPS et
# adresses publiques seulement (protection SSRF). Préfère le réseau
# dédié de docker-compose.n8n.yml. Lis docs/webhooks.md avant.
WEBHOOKS_ALLOW_PRIVATE=0

# [optionnelle] En-têtes de proxy crus pour l'IP du client (limites de
# débit) : none (défaut) | cloudflare. Ne mets cloudflare que si
# Cloudflare est vraiment devant : sinon l'en-tête est falsifiable.
# CDN_TRUST_MODE=none


# ---------------------------------------------------------------------
# 9. Intégration Radar (optionnelle)
# ---------------------------------------------------------------------
# Radar est un outil de prospection externe qui demande des audits par
# API et reçoit l'ouverture des liens de suivi. Intégration générique :
# n'importe quel outil peut suivre le même contrat (docs/radar.md).
# Laisse tout commenté si tu ne t'en sers pas.

# [optionnelle] Clé Bearer attendue sur /api/radar/*. 24 caractères
# minimum. Non définie : ces routes répondent 503.
#   openssl rand -hex 32
# RADAR_API_KEY=
# [optionnelle] Nouveaux audits par jour pour Radar. Défaut 20.
# RADAR_DAILY_AUDIT_QUOTA=20
# [optionnelles] Webhook « audit_viewed » au format historique de Radar.
# Les deux définies : un webhook « Format Radar historique » est créé au
# démarrage (Réglages > Webhooks). HTTPS obligatoire, secret 24+ caractères.
# RADAR_WEBHOOK_URL=https://radar.example.com/webhooks/mynto
# RADAR_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
# 10. Hors Docker (développement, installation manuelle)
# ---------------------------------------------------------------------
# docker-compose.yml définit ces valeurs lui-même.

# [obligatoire hors Docker] Postgres 16+, côté serveur uniquement.
# DATABASE_URL=postgres://mynto:change-me@localhost:5432/mynto
# [obligatoire hors Docker pour le scanner, optionnelle pour le web]
# REDIS_URL=redis://localhost:6379
# [optionnelle] Dossier des médias partagé web + scanner. Défaut /data/media.
# MEDIA_DIR=./.local/media
# [optionnelle] URL du scanner vue par le web. Défaut http://localhost:4000.
# SCANNER_API_URL=http://localhost:4000
# [optionnelle] URL du web vue par le scanner (export PDF). Défaut
# http://localhost:3000.
# WEB_BASE_URL=http://localhost:3000
# [optionnelle] Port du scanner. Défaut 4000.
# PORT=4000
# [optionnelle] fatal | error | warn | info (défaut) | debug | trace | silent
# LOG_LEVEL=info
# [développement seulement] Ancienne forme de PUBLIC_URL, figée au build
# de Next.js. Ne la définis pas en Docker.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
